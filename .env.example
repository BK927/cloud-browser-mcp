# Copy to .env (never commit real .env). Use your actual tailnet DNS name.
CB_PUBLIC_ORIGIN=https://YOUR-HOST.YOUR-TAILNET.ts.net
# Optional canonical external prefix. Proxy must strip it before forwarding.
# Example /browser; also route the two standard well-known URLs in docs/PUBLIC_PATH_PREFIX.md.
CB_PUBLIC_PATH_PREFIX=""
CB_CONTROL_ORIGIN=https://YOUR-HOST.YOUR-TAILNET.ts.net:8443
CB_OAUTH_CLIENT_ID=personal-cloud-browser
# Exact callback from ChatGPT's app setup. No wildcard or arbitrary DCR.
CB_OAUTH_REDIRECT_URIS=["https://chatgpt.com/connector_platform_oauth_redirect"]
# Generate with: uv run cloud-browser hash-password
# Single quotes are required to preserve $ characters in an Argon2 hash.
CB_ADMIN_PASSWORD_HASH='REPLACE_WITH_ARGON2ID_HASH'
CB_MANUAL_CONTROL_ENABLED=true
# Default: block iframe screenshots. Optional mask = viewport-only blacked-out frames.
# Masking is not iframe automation and cannot be enabled through MCP tools.
CB_IFRAME_SCREENSHOT_POLICY=block
CB_PUBLIC_PORT=8000
CB_CONTROL_PORT=8001
# Temporary, payload-free public ASGI lifecycle JSON logs to stderr. Default off.
# Known method/path only; max 120 events/minute. See docs/HTTP_DIAGNOSTICS.md.
CB_HTTP_DIAGNOSTICS=false
CB_MEMORY_RESERVE_MB=256
CB_MEMORY_PER_TAB_MB=96
CB_MAX_CAPTURE_PIXELS=8000000
CB_NAVIGATION_TIMEOUT=20
CB_SESSION_TTL=3600
CB_APPROVAL_TTL=120
CB_HANDOFF_TTL=600
# Optional native page-tool bridge. Testing mode opts into Chromium's experimental WebMCP flag.
CB_WEBMCP_ENABLED=true
CB_WEBMCP_TESTING=false
# Operator-owned, exact-origin indicators; no universal login-success guessing.
CB_AUTH_RULES={}
# Example: {"https://example.com":{"supported_methods":["password","sso"],"success_selector":"[data-test=account-menu]","failure_selector":"[data-test=login-error]"}}
CB_MAX_UPLOAD_MB=16
CB_MAX_STAGED_UPLOADS=8
CB_UPLOAD_TTL=600
# Suggested starting limits, NOT measured Pi guarantees. Operator can change them.
CB_BROWSER_MEMORY_LIMIT=1400m
CB_PROXY_MEMORY_LIMIT=128m
CB_INGRESS_MEMORY_LIMIT=64m
CB_SHARED_MEMORY=256m
