# Copy to .env (never commit real .env). Use your actual tailnet DNS name.
CB_PUBLIC_ORIGIN=https://YOUR-HOST.YOUR-TAILNET.ts.net
# Optional canonical external prefix. Proxy must strip it before forwarding.
# Example /browser; also route the two standard well-known URLs in docs/PUBLIC_PATH_PREFIX.md.
CB_PUBLIC_PATH_PREFIX=""
CB_CONTROL_ORIGIN=https://YOUR-HOST.YOUR-TAILNET.ts.net:8443
CB_OAUTH_CLIENT_ID=personal-cloud-browser
# Exact callback from ChatGPT's app setup. No wildcard or arbitrary DCR.
CB_OAUTH_REDIRECT_URIS=["https://chatgpt.com/connector_platform_oauth_redirect"]
# Generate with: uv run cloud-browser hash-password
# Single quotes are required to preserve $ characters in an Argon2 hash.
CB_ADMIN_PASSWORD_HASH='REPLACE_WITH_ARGON2ID_HASH'
# Optional shared passkey front door. Keep the generated value server-side only.
# Use the same random secret (at least 32 characters) in both private env files.
# Empty keeps the existing administrator-password login. See docs/PASSKEY_LOGIN.md.
CB_PASSKEY_BRIDGE_SECRET=""
CB_MANUAL_CONTROL_ENABLED=true
# Inspect ordinary frames; mask sensitive/uninspectable frame regions.
# Legacy stronger operator choices: block (all images with frames), mask (all frames).
CB_IFRAME_SCREENSHOT_POLICY=inspect
# Match the home server's real browser locale and timezone (operator settings).
# CB_BROWSER_LANGUAGE=ko-KR
# CB_BROWSER_ACCEPT_LANGUAGE=ko-KR,ko,en-US,en
# CB_BROWSER_TIMEZONE=Asia/Seoul
# Logged-out public reader: persistent profile, idle close frees RAM (TTL 60..3600s).
# CB_READER_ENABLED=true
# Reader-only: false may lower RAM on ad-heavy pages but weakens cross-site isolation.
# Acceptable only for this never-logged-in profile; interactive browsers stay isolated.
# CB_READER_SITE_ISOLATION=true
# CB_READER_IDLE_TTL=300
# Navigation budget (5..40s, at most CB_NAVIGATION_MAX_TIMEOUT).
# CB_READER_TIMEOUT=25
# Cached text per read (4000..250000 characters).
# CB_READER_MAX_TEXT_CHARS=60000
CB_PUBLIC_PORT=8000
CB_CONTROL_PORT=8001
# Temporary, payload-free public ASGI lifecycle JSON logs to stderr. Default off.
# Known method/path only; max 120 events/minute. See docs/HTTP_DIAGNOSTICS.md.
CB_HTTP_DIAGNOSTICS=false
CB_MEMORY_RESERVE_MB=256
CB_MEMORY_PER_TAB_MB=96
# Soft policy only; container/systemd hard RAM and swap caps remain operator-owned.
CB_MEMORY_POLICY=adaptive
CB_MEMORY_FLOOR_MB=96
CB_MEMORY_PER_SESSION_MB=192
CB_MAX_SESSIONS=2
CB_MAX_CAPTURE_PIXELS=8000000
# Per-work metadata budget across tabs and frames; seconds for navigation settings.
CB_NODE_REGISTRY_BYTES=2097152
# Call/tab preferences cannot raise the operator ceiling.
CB_NAVIGATION_TIMEOUT=60
CB_NAVIGATION_MAX_TIMEOUT=300
# Polite per-host navigation spacing (0..60000 ms) and sliding-minute cap (1..600).
CB_NAVIGATION_MIN_INTERVAL_MS=1500
CB_NAVIGATION_PER_HOST_PER_MINUTE=30
CB_SESSION_TTL=3600
# Private operator-console login, independent of browser work-session lifetime.
CB_CONTROL_SESSION_TTL=28800
# OAuth refresh expires after 30 days idle; an active connection lasts at most 90 days.
CB_REFRESH_TTL=2592000
CB_GRANT_MAX_TTL=7776000
# Idle TTL renews after successful work, not status polling. Protected login never auto-unlocks.
CB_SESSION_SWEEP_INTERVAL=15
CB_COMMAND_QUEUE_TIMEOUT=46
CB_MAX_QUEUED_PER_WORK=4
CB_APPROVAL_TTL=120
# Opt-in balanced-v2: ordinary non-sensitive edits, selection/check, links and search.
# Submissions/unknown actions remain gated. See docs/APPROVAL_POLICY.md for limits.
CB_APPROVAL_POLICY=strict

# Optional preauthorized read-only page tools. Only the operator may configure
# exact origin -> tool name -> schema_sha256 from browser_list_page_tools.
CB_WEBMCP_READ_ALLOWLIST={}
CB_MAX_ARTIFACT_MB=64
CB_MAX_ARTIFACT_FILE_MB=16
CB_ARTIFACT_TTL=1800
CB_HANDOFF_TTL=600
# Optional native page-tool bridge. Testing mode opts into Chromium's experimental WebMCP flag.
CB_WEBMCP_ENABLED=true
CB_WEBMCP_TESTING=false
# Operator-owned, exact-origin indicators; no universal login-success guessing.
CB_AUTH_RULES={}
# Example: {"https://example.com":{"supported_methods":["password","sso"],"success_selector":"[data-test=account-menu]","failure_selector":"[data-test=login-error]"}}
CB_MAX_UPLOAD_MB=16
CB_MAX_STAGED_UPLOADS=8
CB_UPLOAD_TTL=600
# Suggested starting limits, NOT measured Pi guarantees. Operator can change them.
CB_BROWSER_MEMORY_LIMIT=1400m
# Processes plus threads, not preallocated memory. Native uses --tasks-max.
CB_BROWSER_TASK_LIMIT=512
CB_PROXY_MEMORY_LIMIT=128m
CB_INGRESS_MEMORY_LIMIT=64m
CB_SHARED_MEMORY=256m
